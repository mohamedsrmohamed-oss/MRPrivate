# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Keep Firebase Realtime Database data models and reflection
-keepclassmembers class com.example.mrprivate.** {
    <fields>;
    <init>(...);
}
-keep class com.example.mrprivate.services.** { *; }
-keep class com.example.mrprivate.data.** { *; }
-keep class com.example.mrprivate.ui.components.** { *; }
-keep class com.example.mrprivate.features.quiz.** { *; }
